# Backend Environment Variables
# Copy to .env and fill in your values

# VPP OpenEnv Server URL
VPP_SERVER_URL=http://localhost:7860

# Simulation WebSocket Server Port
SIMULATION_PORT=8001

# Hugging Face API (optional, for LLM agent)
# If not provided, will fall back to rule-based agent
HF_TOKEN=

# LLM Configuration (optional)
API_BASE_URL=https://router.huggingface.co/v1
MODEL_NAME=Qwen/Qwen2.5-72B-Instruct

# Logging
LOG_LEVEL=INFO
